{
  "data": {
    "dataset": "MNIST",
    "data_path": "./data/datasets",
    "batch_size": 64
  },
  "training": {
    "global_rounds": 4,
    "local_epochs": 1,
    "learning_rate": 0.01,
    "optimizer": "SGD",
    "momentum": 0.9,
    "weight_decay": 0.0001
  },
  "model": {
    "architecture": "CNN",
    "resnet_depth": 18
  },
  "clustered": {
    "num_clusters": 5,
    "total_clients": 10,
    "assignment": "class_based",
    "sharing": {
      "enabled": true,
      "beta": 0.7,
      "interval": 2,
      "mode": "full_model"
    },
    "migration": {
      "schedule": [
        {
          "round": 2,
          "clients": [
            0
          ],
          "src": 0,
          "dst": 4
        }
      ],
      "behavior_change": "membership_only",
      "keep_weights": true
    },
    "evaluation": {
      "cluster_test": true,
      "global_test": true,
      "variance_window": 10
    }
  },
  "experiment": {
    "name": "clustered_caseB",
    "seed": 42,
    "device": "auto"
  },
  "logging": {
    "save_path": "./logs/results",
    "verbose": true
  },
  "plotting": {
    "enabled": true,
    "save_path": "./plots/results"
  }
}