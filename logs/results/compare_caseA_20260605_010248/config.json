{
  "data": {
    "dataset": "MNIST",
    "data_path": "./data/datasets",
    "batch_size": 128,
    "eval_batch_size": 1024
  },
  "training": {
    "global_rounds": 60,
    "local_epochs": 1,
    "learning_rate": 0.01,
    "optimizer": "SGD",
    "momentum": 0.9,
    "weight_decay": 0.0001
  },
  "model": {
    "architecture": "CNN",
    "resnet_depth": 18
  },
  "clustered": {
    "num_clusters": 5,
    "total_clients": 20,
    "assignment": "class_based",
    "sharing": {
      "enabled": false,
      "beta": 0.7,
      "interval": 5,
      "mode": "full_model"
    },
    "migration": {
      "schedule": [
        {
          "round": 30,
          "clients": [
            0
          ],
          "src": 0,
          "dst": 4
        }
      ],
      "behavior_change": "membership_only",
      "keep_weights": true
    },
    "evaluation": {
      "cluster_test": true,
      "global_test": true,
      "variance_window": 10
    }
  },
  "experiment": {
    "name": "compare_caseA",
    "seed": 42,
    "device": "auto"
  },
  "logging": {
    "save_path": "./logs/results",
    "verbose": true
  },
  "plotting": {
    "enabled": true,
    "save_path": "./plots/results"
  }
}