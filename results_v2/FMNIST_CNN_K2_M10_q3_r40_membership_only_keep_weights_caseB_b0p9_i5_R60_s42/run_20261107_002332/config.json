{
  "data": {
    "dataset": "F-MNIST",
    "data_path": "/root/cfm-repo/data/datasets",
    "batch_size": 256,
    "eval_batch_size": 1024
  },
  "training": {
    "global_rounds": 60,
    "local_epochs": 1,
    "learning_rate": 0.01,
    "optimizer": "SGD",
    "momentum": 0.9,
    "weight_decay": 0.0001
  },
  "model": {
    "architecture": "CNN",
    "resnet_depth": 18
  },
  "clustered": {
    "num_clusters": 2,
    "total_clients": 20,
    "assignment": "class_based",
    "sharing": {
      "enabled": true,
      "beta": 0.9,
      "interval": 5,
      "mode": "full_model"
    },
    "migration": {
      "schedule": [
        {
          "round": 40,
          "clients": [
            0,
            1,
            2
          ],
          "src": 0,
          "dst": 1
        }
      ],
      "behavior_change": "membership_only",
      "keep_weights": true,
      "handover": "keep_weights",
      "reserve_for_migrants": true,
      "control": false
    },
    "evaluation": {
      "cluster_test": true,
      "global_test": true,
      "variance_window": 10
    }
  },
  "experiment": {
    "name": "run",
    "seed": 42,
    "device": "auto"
  },
  "logging": {
    "save_path": "/root/cfm-repo/results_v2/FMNIST_CNN_K2_M10_q3_r40_membership_only_keep_weights_caseB_b0p9_i5_R60_s42",
    "verbose": false
  },
  "plotting": {
    "enabled": false,
    "save_path": "./plots/results"
  }
}